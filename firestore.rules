rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedSignedIn() && (
        request.auth.token.email == 'aneetkum52dss@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNonNegNumber(val) {
      return val is number && val >= 0;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 200000));
    }

    // Entity Validation Blueprints (Pillar 2: Strict Keys, Types, Sizes, Regex)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'username', 'photoUrl', 'bio',
          'isPrivate', 'allowReelDownloads', 'isVerified', 'isBanned',
          'followersCount', 'followingCount', 'postsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoUrl', 'bio',
          'isPrivate', 'allowReelDownloads', 'isVerified', 'isBanned',
          'followersCount', 'followingCount', 'postsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32 && data.username.matches('^[a-zA-Z0-9_.]+$')
        && data.photoUrl is string && data.photoUrl.size() <= 200000
        && data.bio is string && data.bio.size() <= 240
        && data.isPrivate is bool
        && data.allowReelDownloads is bool
        && data.isVerified is bool
        && data.isBanned is bool
        && isNonNegNumber(data.followersCount)
        && isNonNegNumber(data.followingCount)
        && isNonNegNumber(data.postsCount)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'blockedUserIds', 'savedPostIds', 'language', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'blockedUserIds', 'savedPostIds', 'language', 'theme', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 160
        && isBoundedStringList(data.blockedUserIds, 100)
        && isBoundedStringList(data.savedPostIds, 200)
        && data.language is string && data.language in ['en', 'hi']
        && data.theme is string && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.grantedBy is string && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorPhoto',
          'mediaType', 'mediaUrls', 'caption', 'hashtags', 'location',
          'visibility', 'status', 'likesCount', 'commentsCount', 'sharesCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorPhoto',
          'mediaType', 'mediaUrls', 'caption', 'hashtags', 'location',
          'visibility', 'status', 'likesCount', 'commentsCount', 'sharesCount',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.authorUsername is string && data.authorUsername.size() >= 2 && data.authorUsername.size() <= 32
        && data.authorPhoto is string && data.authorPhoto.size() <= 200000
        && data.mediaType is string && data.mediaType in ['photo', 'carousel', 'video']
        && data.mediaUrls is list && data.mediaUrls.size() >= 1 && data.mediaUrls.size() <= 5 && data.mediaUrls[0] is string && data.mediaUrls[0].size() <= 200000
        && data.caption is string && data.caption.size() <= 1000
        && isBoundedStringList(data.hashtags, 10)
        && data.location is string && data.location.size() <= 100
        && data.visibility is string && data.visibility in ['public', 'followers']
        && data.status is string && data.status in ['active', 'removed']
        && isNonNegNumber(data.likesCount)
        && isNonNegNumber(data.commentsCount)
        && isNonNegNumber(data.sharesCount)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLikeRecord(data) {
      return data.keys().hasAll(['userId', 'targetId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'targetId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.targetId)
        && data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'targetId', 'authorId', 'authorName', 'authorPhoto', 'text', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'targetId', 'authorId', 'authorName', 'authorPhoto', 'text', 'status', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.targetId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.authorPhoto is string && data.authorPhoto.size() <= 200000
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
        && data.status is string && data.status in ['active', 'removed']
        && data.createdAt is timestamp;
    }

    function isValidReel(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorPhoto',
          'posterUrl', 'videoUrl', 'durationSec', 'caption', 'hashtags',
          'musicTitle', 'musicPresetId', 'allowDownload', 'status',
          'likesCount', 'commentsCount', 'sharesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorPhoto',
          'posterUrl', 'videoUrl', 'durationSec', 'caption', 'hashtags',
          'musicTitle', 'musicPresetId', 'allowDownload', 'status',
          'likesCount', 'commentsCount', 'sharesCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.authorUsername is string && data.authorUsername.size() >= 2 && data.authorUsername.size() <= 32
        && data.authorPhoto is string && data.authorPhoto.size() <= 200000
        && data.posterUrl is string && data.posterUrl.size() <= 200000
        && data.videoUrl is string && data.videoUrl.size() <= 200000
        && data.durationSec is number && data.durationSec >= 15 && data.durationSec <= 180
        && data.caption is string && data.caption.size() <= 600
        && isBoundedStringList(data.hashtags, 10)
        && data.musicTitle is string && data.musicTitle.size() <= 100
        && data.musicPresetId is string && data.musicPresetId.size() <= 40
        && data.allowDownload is bool
        && data.status is string && data.status in ['active', 'removed']
        && isNonNegNumber(data.likesCount)
        && isNonNegNumber(data.commentsCount)
        && isNonNegNumber(data.sharesCount)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorPhoto',
          'mediaType', 'mediaUrl', 'caption', 'status', 'viewsCount',
          'expiresAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorPhoto',
          'mediaType', 'mediaUrl', 'caption', 'status', 'viewsCount',
          'expiresAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.authorUsername is string && data.authorUsername.size() >= 2 && data.authorUsername.size() <= 32
        && data.authorPhoto is string && data.authorPhoto.size() <= 200000
        && data.mediaType is string && data.mediaType in ['photo', 'video']
        && data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 200000
        && data.caption is string && data.caption.size() <= 240
        && data.status is string && data.status in ['active', 'removed']
        && isNonNegNumber(data.viewsCount)
        && data.expiresAtMs is number && data.expiresAtMs > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStoryView(data) {
      return data.keys().hasAll(['storyId', 'storyAuthorId', 'viewerId', 'viewerName', 'viewerPhoto', 'viewedAt'])
        && data.keys().hasOnly(['storyId', 'storyAuthorId', 'viewerId', 'viewerName', 'viewerPhoto', 'viewedAt'])
        && isValidId(data.storyId)
        && isValidId(data.storyAuthorId)
        && isValidId(data.viewerId)
        && data.viewerName is string && data.viewerName.size() >= 1 && data.viewerName.size() <= 60
        && data.viewerPhoto is string && data.viewerPhoto.size() <= 200000
        && data.viewedAt is timestamp;
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt'])
        && data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && isValidId(data.followerId)
        && isValidId(data.followingId)
        && data.followerId != data.followingId
        && data.createdAt is timestamp;
    }

    function isValidChatThread(data) {
      return data.keys().hasAll([
          'id', 'participantIds', 'userAId', 'userAName', 'userAPhoto',
          'userBId', 'userBName', 'userBPhoto', 'lastMessage', 'lastSenderId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'participantIds', 'userAId', 'userAName', 'userAPhoto',
          'userBId', 'userBName', 'userBPhoto', 'lastMessage', 'lastSenderId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.participantIds is list && data.participantIds.size() == 2 && data.participantIds[0] is string && data.participantIds[1] is string
        && isValidId(data.userAId)
        && data.userAName is string && data.userAName.size() >= 1 && data.userAName.size() <= 60
        && data.userAPhoto is string && data.userAPhoto.size() <= 200000
        && isValidId(data.userBId)
        && data.userBName is string && data.userBName.size() >= 1 && data.userBName.size() <= 60
        && data.userBPhoto is string && data.userBPhoto.size() <= 200000
        && data.lastMessage is string && data.lastMessage.size() <= 240
        && isValidId(data.lastSenderId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'id', 'chatId', 'participantIds', 'senderId', 'senderName',
          'type', 'text', 'mediaUrl', 'voiceDurationSec', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'participantIds', 'senderId', 'senderName',
          'type', 'text', 'mediaUrl', 'voiceDurationSec', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.chatId)
        && data.participantIds is list && data.participantIds.size() == 2 && data.participantIds[0] is string && data.participantIds[1] is string
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60
        && data.type is string && data.type in ['text', 'photo', 'video', 'voice', 'story_reply']
        && data.text is string && data.text.size() <= 1000
        && data.mediaUrl is string && data.mediaUrl.size() <= 200000
        && data.voiceDurationSec is number && data.voiceDurationSec >= 0 && data.voiceDurationSec <= 120
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'id', 'recipientId', 'actorId', 'actorName', 'actorPhoto',
          'type', 'targetId', 'message', 'isRead', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'recipientId', 'actorId', 'actorName', 'actorPhoto',
          'type', 'targetId', 'message', 'isRead', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.recipientId)
        && isValidId(data.actorId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 60
        && data.actorPhoto is string && data.actorPhoto.size() <= 200000
        && data.type is string && data.type in ['like', 'comment', 'follow', 'reel_share', 'story_reply']
        && data.targetId is string && data.targetId.size() <= 128
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 240
        && data.isRead is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
          'id', 'reporterId', 'reporterName', 'targetType', 'targetId',
          'reason', 'details', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'reporterId', 'reporterName', 'targetType', 'targetId',
          'reason', 'details', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.reporterId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 60
        && data.targetType is string && data.targetType in ['user', 'post', 'reel']
        && isValidId(data.targetId)
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 100
        && data.details is string && data.details.size() <= 500
        && data.status is string && data.status in ['open', 'resolved', 'dismissed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 1000
        && data.status is string && data.status in ['open', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // 1. PUBLIC USER PROFILES (PII-FREE)
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && (resource.data.isBanned == false || resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (request.auth.uid == userId
            && incoming().isVerified == false
            && incoming().isBanned == false
            && incoming().followersCount == 0
            && incoming().followingCount == 0
            && incoming().postsCount == 0)
          || isAdmin()
        );

      allow update: if isVerifiedSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Admin moderation (verify/ban/correct counts)
          isAdmin() ||
          // Action: Owner edits own public profile fields
          (request.auth.uid == userId
            && existing().isBanned == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'photoUrl', 'bio', 'isPrivate', 'allowReelDownloads', 'updatedAt'])) ||
          // Action: Owner increments/decrements own postsCount
          (request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['postsCount', 'updatedAt'])
            && (incoming().postsCount == existing().postsCount + 1 || incoming().postsCount == existing().postsCount - 1)) ||
          // Action: Owner increments/decrements own followingCount
          (request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt'])
            && (incoming().followingCount == existing().followingCount + 1 || incoming().followingCount == existing().followingCount - 1)) ||
          // Action: Atomic follower count sync when another user follows/unfollows
          (request.auth.uid != userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && (
              (incoming().followersCount == existing().followersCount + 1
                && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)))
              ||
              (incoming().followersCount == existing().followersCount - 1
                && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)))
            ))
        );

      allow delete: if isVerifiedSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // =========================================================================
    // 2. ISOLATED PRIVATE USER PII & SETTINGS
    // =========================================================================
    match /user_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;

      allow create: if isVerifiedSignedIn()
        && isValidId(userId)
        && isValidUserPrivate(incoming())
        && request.auth.uid == userId
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(userId)
        && isValidUserPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['blockedUserIds', 'savedPostIds', 'language', 'theme', 'updatedAt']))
        );

      allow delete: if isVerifiedSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // =========================================================================
    // 3. TRUSTED ADMINS REGISTRY
    // =========================================================================
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isAdmin() && isValidId(userId) && isValidAdminRecord(incoming()) && incoming().uid == userId && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // =========================================================================
    // 4. POSTS (PHOTO, CAROUSEL, VIDEO) + LIKES & COMMENTS
    // =========================================================================
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().id == postId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().authorId == request.auth.uid
            && incoming().status == 'active'
            && incoming().likesCount == 0
            && incoming().commentsCount == 0
            && incoming().sharesCount == 0
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
          || isAdmin()
        );

      allow update: if isVerifiedSignedIn()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().authorId == request.auth.uid
            && existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'hashtags', 'location', 'visibility', 'updatedAt'])) ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (
              (incoming().likesCount == existing().likesCount + 1
                && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
              ||
              (incoming().likesCount == existing().likesCount - 1
                && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
            )) ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1) ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt'])
            && incoming().sharesCount == existing().sharesCount + 1)
        );

      allow delete: if isVerifiedSignedIn() && isValidId(postId) && (existing().authorId == request.auth.uid || isAdmin());

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(userId);
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

        allow create: if isVerifiedSignedIn()
          && isValidId(postId)
          && isValidId(userId)
          && userId == request.auth.uid
          && isValidLikeRecord(incoming())
          && incoming().userId == request.auth.uid
          && incoming().targetId == postId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount + 1;

        allow update: if false;

        allow delete: if isVerifiedSignedIn()
          && isValidId(postId)
          && isValidId(userId)
          && (userId == request.auth.uid || isAdmin())
          && exists(/databases/$(database)/documents/posts/$(postId))
          && (isAdmin() || getAfter(/databases/$(database)/documents/posts/$(postId)).data.likesCount == get(/databases/$(database)/documents/posts/$(postId)).data.likesCount - 1);
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());

        allow create: if isVerifiedSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().id == commentId
          && incoming().targetId == postId
          && incoming().authorId == request.auth.uid
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'active';

        allow update: if isVerifiedSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().id == existing().id
          && incoming().targetId == existing().targetId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && isAdmin();

        allow delete: if isVerifiedSignedIn()
          && isValidId(postId)
          && isValidId(commentId)
          && (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    // =========================================================================
    // 5. REELS (15s - 180s VERTICAL VIDEOS) + LIKES & COMMENTS
    // =========================================================================
    match /reels/{reelId} {
      allow get: if isSignedIn() && isValidId(reelId);
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(reelId)
        && isValidReel(incoming())
        && incoming().id == reelId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().authorId == request.auth.uid
            && incoming().status == 'active'
            && incoming().likesCount == 0
            && incoming().commentsCount == 0
            && incoming().sharesCount == 0
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
          || isAdmin()
        );

      allow update: if isVerifiedSignedIn()
        && isValidId(reelId)
        && isValidReel(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().authorId == request.auth.uid
            && existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'hashtags', 'allowDownload', 'musicTitle', 'musicPresetId', 'updatedAt'])) ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (
              (incoming().likesCount == existing().likesCount + 1
                && existsAfter(/databases/$(database)/documents/reels/$(reelId)/likes/$(request.auth.uid)))
              ||
              (incoming().likesCount == existing().likesCount - 1
                && !existsAfter(/databases/$(database)/documents/reels/$(reelId)/likes/$(request.auth.uid)))
            )) ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1) ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt'])
            && incoming().sharesCount == existing().sharesCount + 1)
        );

      allow delete: if isVerifiedSignedIn() && isValidId(reelId) && (existing().authorId == request.auth.uid || isAdmin());

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(reelId) && isValidId(userId);
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

        allow create: if isVerifiedSignedIn()
          && isValidId(reelId)
          && isValidId(userId)
          && userId == request.auth.uid
          && isValidLikeRecord(incoming())
          && incoming().userId == request.auth.uid
          && incoming().targetId == reelId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/reels/$(reelId))
          && getAfter(/databases/$(database)/documents/reels/$(reelId)).data.likesCount == get(/databases/$(database)/documents/reels/$(reelId)).data.likesCount + 1;

        allow update: if false;

        allow delete: if isVerifiedSignedIn()
          && isValidId(reelId)
          && isValidId(userId)
          && (userId == request.auth.uid || isAdmin())
          && exists(/databases/$(database)/documents/reels/$(reelId))
          && (isAdmin() || getAfter(/databases/$(database)/documents/reels/$(reelId)).data.likesCount == get(/databases/$(database)/documents/reels/$(reelId)).data.likesCount - 1);
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(reelId) && isValidId(commentId);
        allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());

        allow create: if isVerifiedSignedIn()
          && isValidId(reelId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().id == commentId
          && incoming().targetId == reelId
          && incoming().authorId == request.auth.uid
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/reels/$(reelId))
          && get(/databases/$(database)/documents/reels/$(reelId)).data.status == 'active';

        allow update: if isVerifiedSignedIn()
          && isValidId(reelId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().id == existing().id
          && incoming().targetId == existing().targetId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && isAdmin();

        allow delete: if isVerifiedSignedIn()
          && isValidId(reelId)
          && isValidId(commentId)
          && (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    // =========================================================================
    // 6. STORIES (24-HOUR EXPIRING) + VIEWERS
    // =========================================================================
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn() && (resource.data.status == 'active' || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().id == storyId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().authorId == request.auth.uid
            && incoming().status == 'active'
            && incoming().viewsCount == 0
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
          || isAdmin()
        );

      allow update: if isVerifiedSignedIn()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt'])
            && incoming().viewsCount == existing().viewsCount + 1
            && existsAfter(/databases/$(database)/documents/stories/$(storyId)/views/$(request.auth.uid)))
        );

      allow delete: if isVerifiedSignedIn() && isValidId(storyId) && (existing().authorId == request.auth.uid || isAdmin());

      match /views/{viewerId} {
        allow get: if isSignedIn() && isValidId(storyId) && isValidId(viewerId)
          && (viewerId == request.auth.uid || (resource != null && existing().storyAuthorId == request.auth.uid) || isAdmin());
        allow list: if isSignedIn() && (resource.data.storyAuthorId == request.auth.uid || resource.data.viewerId == request.auth.uid || isAdmin());

        allow create: if isVerifiedSignedIn()
          && isValidId(storyId)
          && isValidId(viewerId)
          && viewerId == request.auth.uid
          && isValidStoryView(incoming())
          && incoming().storyId == storyId
          && incoming().viewerId == request.auth.uid
          && incoming().viewedAt == request.time
          && exists(/databases/$(database)/documents/stories/$(storyId))
          && incoming().storyAuthorId == get(/databases/$(database)/documents/stories/$(storyId)).data.authorId;

        allow update: if false;
        allow delete: if isAdmin() && isValidId(storyId) && isValidId(viewerId);
      }
    }

    // =========================================================================
    // 7. FOLLOWS
    // =========================================================================
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn() && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(followId)
        && isValidFollow(incoming())
        && incoming().followerId == request.auth.uid
        && followId == (incoming().followerId + '_' + incoming().followingId)
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().followingId));

      allow update: if false;

      allow delete: if isVerifiedSignedIn()
        && isValidId(followId)
        && (existing().followerId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 8. DIRECT CHATS + MESSAGES (STRICT PARTICIPANT ISOLATION)
    // =========================================================================
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (resource == null || request.auth.uid in existing().participantIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(chatId)
        && isValidChatThread(incoming())
        && incoming().id == chatId
        && request.auth.uid in incoming().participantIds
        && incoming().lastSenderId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(chatId)
        && isValidChatThread(incoming())
        && incoming().id == existing().id
        && incoming().participantIds == existing().participantIds
        && incoming().userAId == existing().userAId
        && incoming().userBId == existing().userBId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid in existing().participantIds
            && incoming().lastSenderId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId)
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

        allow create: if isVerifiedSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().id == messageId
          && incoming().chatId == chatId
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && incoming().participantIds == get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;

        allow update: if false;

        allow delete: if isVerifiedSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // =========================================================================
    // 9. NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().id == notificationId
        && incoming().actorId == request.auth.uid
        && incoming().isRead == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().recipientId == existing().recipientId
        && incoming().actorId == existing().actorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().recipientId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
        );

      allow delete: if isVerifiedSignedIn()
        && isValidId(notificationId)
        && (existing().recipientId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 10. MODERATION REPORTS (TERMINAL STATE LOCKED)
    // =========================================================================
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().id == reportId
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().id == existing().id
        && incoming().reporterId == existing().reporterId
        && incoming().targetType == existing().targetType
        && incoming().targetId == existing().targetId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // =========================================================================
    // 11. HELP & SUPPORT TICKETS (TERMINAL STATE LOCKED)
    // =========================================================================
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedSignedIn()
        && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && incoming().id == ticketId
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid
            && existing().status == 'open'
            && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(ticketId);
    }
  }
}
